{
  "name": "wevocalanalyzer",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "description": "声の解析（スペクトログラム、F0、フォルマント）をする Web ツール兼ライブラリ。ブラウザで動き、音声を外部に送らない",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./lyrics": "./src/lyrics.ts"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build && node scripts/build-addons.mjs",
    "build:addons": "node scripts/build-addons.mjs public",
    "test:mora": "node --experimental-strip-types scripts/test-mora.mjs",
    "lint": "oxlint app src",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@huggingface/transformers": "^4.3.1",
    "@mui/material": "^9.4.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "kuromoji": "^0.1.2",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
