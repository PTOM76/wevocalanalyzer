{
    // https://github.com/Pitan76/Todofile

    // ---- セットアップ ----
    // 初回だけ。Rust は DSP (dsp/) を触るときだけ要る
    "setup": [
        "git submodule update --init",
        "npm install"
    ],
    // wasm32 ターゲットを入れる (入っていれば何もしない)
    "wasm:setup": "rustup target add wasm32-unknown-unknown",
    // WeVocalSynth の submodule として開発するとき: こちらの pevenmui/ を隠し、隣の ../pevenmui だけを使う
    // (同じものが2か所に見えて、違う方を直さないように)
    "setup:nested": [
        "git submodule deinit -f pevenmui",
        "git submodule deinit -f wevocal-lib",
        "git sparse-checkout set --no-cone \"/*\" \"!/pevenmui/\" \"!/wevocal-lib/\""
    ],
    // 隣（WeVocalSynth 側）の pevenmui・wevocal-lib を更新したら、こちらの submodule の登録もそのコミットに合わせてコミットする
    "update:nested": "node scripts/update-nested.mjs",

    // ---- 開発 ----
    "dev": "npm run dev",
    "build": "npm run build",
    "preview": "npm run preview",
    // dsp/ をビルドして src/dsp.wasm を作り直す。DSP を変えたら結果もコミットする
    "wasm": "npm run build:wasm",

    // ---- 確認 ----
    "lint": "npm run lint",
    // wevocal-lib は隣（WeVocalSynth の submodule として開発するとき）か、自分の submodule のものを使う
    "test": "node scripts/test-dsp.mjs",
    // コミット前にまとめて通す。書き換えはしない
    "check": [
        "todo lint",
        "todo test",
        "todo build"
    ],

    // ---- リリース ----
    // package.json / package-lock.json を更新し、"bump version x.y.z" でコミットして vx.y.z タグを打つ
    // 作業ツリーがきれいでないと失敗する。最後にコミットとタグを push する
    // 最初に update:nested で submodule（pevenmui・wevocal-lib）の登録を隣の今のコミットに合わせる
    // （手元は隣を使うので通るが、CI はこちらの登録でビルドするため、合わせ忘れると CI だけ落ちる）
    // src/index.ts の ANALYZER_VERSION も合わせて上げる
    "bump": "todo bump:patch",
    "bump:patch": [
        "todo update:nested",
        "npm version patch -m \"bump version %s\"",
        "git push --follow-tags"
    ],
    "bump:minor": [
        "todo update:nested",
        "npm version minor -m \"bump version %s\"",
        "git push --follow-tags"
    ],
    "bump:major": [
        "todo update:nested",
        "npm version major -m \"bump version %s\"",
        "git push --follow-tags"
    ]
}
